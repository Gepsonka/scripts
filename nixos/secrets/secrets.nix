# Read by the `agenix` CLI only (run it from this directory): it decides WHO can decrypt each file.
#   admin.pub : your personal ssh public key(s), one per line. All of them can ssh in; the ed25519/rsa
#               ones can also edit/re-key secrets (age cannot encrypt to ecdsa or security-key types).
#   host.pub  : public half of the machine's decryption key (generated by scripts/init.sh).
let
  lines =
    file:
    builtins.filter (l: builtins.isString l && builtins.match "(ssh-ed25519|ssh-rsa) .*" l != null) (
      builtins.split "\n" (builtins.readFile file)
    );
  keys = lines ./admin.pub ++ lines ./host.pub;
in
{
  "cloudflared-credentials.age".publicKeys = keys; # tunnel credentials JSON
  "mysql-root-password.age".publicKeys = keys;
  "site-db-password.age".publicKeys = keys;
  "admin-password.age".publicKeys = keys; # ERPNext "Administrator" login
  "encryption-key.age".publicKeys = keys; # Frappe encryption_key (must match restored data)
  "r2-access-key-id.age".publicKeys = keys;
  "r2-secret-access-key.age".publicKeys = keys;
  "tailscale-authkey.age".publicKeys = keys; # tskey-auth-..., joins the tailnet on first boot
  "healthchecks-ping-key.age".publicKeys = keys; # optional: healthchecks.io project ping key (email alerts)
}
